<UserControl x:Class="Ouroboros.Controls.Views.SkillsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModel="clr-namespace:Ouroboros.ViewModel"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModel:SkillsViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0"
                   Margin="0,0,8,0">
            <TextBlock DockPanel.Dock="Top"
                       Text="Skills"
                       FontWeight="Bold"
                       Margin="0,0,0,4" />
            <ListView ItemsSource="{Binding Skills}"
                      FontFamily="Consolas">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Slot"
                                        DisplayMemberBinding="{Binding Slot}"
                                        Width="50" />
                        <GridViewColumn Header="Name"
                                        DisplayMemberBinding="{Binding Name}"
                                        Width="180" />
                        <GridViewColumn Header="Status"
                                        DisplayMemberBinding="{Binding Status}"
                                        Width="90" />
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>

        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top"
                       Text="Spells"
                       FontWeight="Bold"
                       Margin="0,0,0,4" />
            <ListView ItemsSource="{Binding Spells}"
                      FontFamily="Consolas">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Slot"
                                        DisplayMemberBinding="{Binding Slot}"
                                        Width="50" />
                        <GridViewColumn Header="Name"
                                        DisplayMemberBinding="{Binding Name}"
                                        Width="180" />
                        <GridViewColumn Header="Status"
                                        DisplayMemberBinding="{Binding Status}"
                                        Width="110" />
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </Grid>
</UserControl>
