<UserControl x:Class="Ouroboros.Controls.Views.PacketConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModel="clr-namespace:Ouroboros.ViewModel"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModel:PacketConsoleViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <StackPanel Margin="20">
        <TextBlock Text="{Binding Title}"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,8" />
        <TextBlock Text="{Binding Placeholder}"
                   TextWrapping="Wrap"
                   Opacity="0.7" />
    </StackPanel>
</UserControl>
