<UserControl x:Class="Ouroboros.Controls.Views.PacketConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewModel="clr-namespace:Ouroboros.ViewModel"
             xmlns:networking="clr-namespace:Ouroboros.Networking"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModel:PacketConsoleViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,6">
            <CheckBox Content="Capture"
                      IsChecked="{Binding IsCapturing}"
                      VerticalAlignment="Center"
                      Margin="0,0,16,0" />
            <Button Content="Clear"
                    Click="ClearButton_Click"
                    Style="{StaticResource MaterialDesignPaperButton}"
                    Margin="0,0,16,0" />
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="filter opcode / hex"
                     Width="170"
                     VerticalAlignment="Center"
                     Margin="0,0,16,0" />
            <TextBlock Text="{Binding Status}"
                       VerticalAlignment="Center"
                       Opacity="0.7" />
        </StackPanel>

        <!-- Log -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Entries}"
                 FontFamily="Consolas"
                 FontSize="11"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type networking:PacketLogEntry}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss.fff}"
                                   Width="90"
                                   Opacity="0.6" />
                        <TextBlock Text="{Binding Arrow}"
                                   Width="44"
                                   Opacity="0.8" />
                        <TextBlock Text="{Binding OpCodeName}"
                                   Width="180" />
                        <TextBlock Text="{Binding Hex}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Craft bar -->
        <Grid Grid.Row="2"
              Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding CraftText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="craft: opcode then tokens, e.g.  0F user(Name) xy(5,5)"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0" />
            <Button Grid.Column="1"
                    Content="→ Server"
                    Click="SendServerButton_Click"
                    Style="{StaticResource MaterialDesignPaperButton}"
                    Margin="0,0,8,0" />
            <Button Grid.Column="2"
                    Content="→ Client"
                    Click="SendClientButton_Click"
                    Style="{StaticResource MaterialDesignPaperButton}" />
        </Grid>
    </Grid>
</UserControl>
